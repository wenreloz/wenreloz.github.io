1:["$","div",null,{"className":"blog-shell","children":[["$","header",null,{"className":"blog-header","children":[["$","a",null,{"href":"/","className":"wordmark","aria-label":"Wen Reloz, home","children":["wr",["$","span",null,{"children":"."}]]}],["$","nav",null,{"aria-label":"Primary navigation","children":[["$","a",null,{"href":"/","children":"PORTFOLIO"}],["$","span",null,{"children":"/"}],["$","a",null,{"href":"/blog","children":"BLOG"}]]}]]}],["$","main",null,{"className":"article-shell","children":[["$","a",null,{"href":"/blog","className":"back-link","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":15}]," All articles"]}],["$","article",null,{"children":[["$","p",null,{"className":"eyebrow","children":[["$","span",null,{"className":"short-rule"}]," ","SOFTWARE / AI"]}],["$","h1",null,{"children":["Using AI Without Giving Up Engineering Judgment",["$","span",null,{"children":"."}]]}],["$","p",null,{"className":"article-lede","children":"How I use AI to move faster while keeping responsibility for technical decisions and results."}],"$undefined",["$","div",null,{"className":"article-rule"}],[["$","div","AI is useful when it shortens the distance between a question and something I can evaluate. I use it to explore approaches, clarify unfamiliar concepts, draft repetitive code, and identify cases I may want to test.",{"children":[["$","p",null,{"children":"AI is useful when it shortens the distance between a question and something I can evaluate. I use it to explore approaches, clarify unfamiliar concepts, draft repetitive code, and identify cases I may want to test."}],"$undefined"]}],["$","div","The useful part is not accepting the first output. It is reviewing the assumptions, checking the code against the system around it, and deciding whether the result is appropriate for the actual requirement.",{"children":[["$","p",null,{"children":"The useful part is not accepting the first output. It is reviewing the assumptions, checking the code against the system around it, and deciding whether the result is appropriate for the actual requirement."}],"$undefined"]}],["$","div","That review matters most in enterprise and healthcare software. Correctness, privacy, maintainability, and clear behavior still belong to the engineer. Generated code needs the same scrutiny as any other contribution.",{"children":[["$","p",null,{"children":"That review matters most in enterprise and healthcare software. Correctness, privacy, maintainability, and clear behavior still belong to the engineer. Generated code needs the same scrutiny as any other contribution."}],"$undefined"]}],["$","div","I treat AI as one tool in the development workflow. It can accelerate exploration and execution, while engineering judgment determines what should reach production.",{"children":[["$","p",null,{"children":"I treat AI as one tool in the development workflow. It can accelerate exploration and execution, while engineering judgment determines what should reach production."}],"$undefined"]}]],"$undefined"]}],["$","aside",null,{"className":"article-end","children":[["$","span",null,{"children":"END OF ARTICLE"}],["$","a",null,{"href":"https://www.linkedin.com/in/wen-reloz-767671206/","target":"_blank","rel":"noopener noreferrer","children":["Continue the conversation ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}]]}],["$","footer",null,{"className":"blog-footer","children":["© ",2026," Wen Reloz ",["$","span",null,{"children":"Always learning. Sometimes writing."}]]}]]}]
