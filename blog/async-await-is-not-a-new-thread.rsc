en":["$","$Lc",null,{"children":[["$","$L8",null,{"providerId":"page:/blog/async-await-is-not-a-new-thread","segmentMap":{"children":["__PAGE__"]},"children":["$","$L9",null,{"id":"page:/blog/async-await-is-not-a-new-thread"}]}],null]}]}]}]}]}]}]}],null,null]
